# Copy to .env and adjust. Every variable has a default (see app/config.py),
# so an empty .env runs the minimal profile.

# --- Application ---
APP_NAME=Osnova Application
# minimal | standard | scalable; a warning is logged at start when it does not match
# the setup (minimal with DATABASE_URL or modules, standard/scalable without DATABASE_URL)
APP_PROFILE=minimal
APP_HOST=localhost
APP_PORT=8000
# true serves /docs, /redoc and /openapi.json; set to false in production
DEBUG=true

# --- Capabilities (each flag enables a module in app/modules) ---
AUTH_ENABLED=false
ADMIN_ENABLED=false
FILES_ENABLED=false
NOTIFICATIONS_ENABLED=false
# Where notifications go besides the bell: in_app (default) or in_app,email
NOTIFICATIONS_CHANNELS=in_app

# --- Nightly cleanup (Celery beat, or cron: python manage.py cleanup); 0 = off ---
# Read notifications are removed this many days after they were created
NOTIFICATIONS_KEEP_DAYS=90
# Accounts that never confirmed the email are removed this many days after sign-up
UNVERIFIED_ACCOUNT_DAYS=0
BACKGROUND_TASKS_ENABLED=false

# --- Languages ---
# Comma-separated codes, see app/core/languages.py (available: en, ru)
LANGUAGES=en,ru
# Must be one of LANGUAGES
DEFAULT_LANGUAGE=en

# Comma-separated origins for local development (Docker uses one origin, no CORS)
CORS_ORIGINS=http://localhost:5173

# --- Forms (app/forms.py) ---
# log (submissions in the application log) | file (also appended to FORMS_FILE as JSON lines)
FORMS_DELIVERY=log
FORMS_FILE=data/forms.jsonl
# Submissions per client IP and form: <count>/<second|minute|hour|day>; empty disables.
# Counted per process: with several workers each one has its own counter.
FORMS_RATE_LIMIT=5/minute

# --- Captcha on forms and sign-up (optional; app/core/captcha.py) ---
# Empty: off. turnstile: Cloudflare Turnstile (keys: dash.cloudflare.com -> Turnstile).
# With the admin on, Admin -> Settings -> Protection switches it off and on.
# Cloudflare test keys for development: site key 1x00000000000000000000AA with secret
# 1x0000000000000000000000000000000AA always pass; secret
# 2x0000000000000000000000000000000AA always fails.
CAPTCHA_PROVIDER=
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=
# Behind a reverse proxy uvicorn takes the client IP from X-Forwarded-For only when the
# proxy address is listed here (Docker Compose sets it, since the API is not published)
# FORWARDED_ALLOW_IPS=127.0.0.1

# --- Database module: enabled when set (required by auth/admin/files) ---
# DATABASE_URL=postgresql+asyncpg://osnova:osnova@localhost:5432/osnova
DATABASE_URL=
DB_ECHO=false

# --- Auth module ---
# At least 32 characters; the app refuses to start with this example value. Generate one:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# jwt (stateless, default) | redis (needs REDIS_URL)
AUTH_STRATEGY=jwt
# true only when served over HTTPS
COOKIE_SECURE=false
# Requests per client IP to each of sign-in, sign-up, password reset, email confirmation
AUTH_RATE_LIMIT=10/minute
# Sign-in with Google: both set turns the button on (README → Sign-in with Google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

REDIS_URL=redis://localhost:6379/0

# --- Settings module (with the admin) ---
# Seconds before each process reloads settings changed in the admin (Admin → Settings)
SETTINGS_REFRESH_SECONDS=30

# --- Files module ---
# local: files in FILES_DIR; s3: an S3-compatible bucket (AWS, MinIO, R2, ...)
FILES_STORAGE=local
FILES_DIR=uploads
FILES_MAX_SIZE_MB=10
# Comma-separated MIME types or prefixes, e.g. image/,application/pdf (empty: any)
FILES_ALLOWED_TYPES=
# S3_ENDPOINT_URL=https://s3.eu-central-1.amazonaws.com
# S3_BUCKET=
S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Lifetime of download links to the bucket, seconds
S3_LINK_SECONDS=300

# --- Email (app/core/mail) ---
# Public address of the frontend: links in emails (Docker Compose sets it from SITE_URL)
FRONTEND_URL=http://localhost:5173
# console: messages are written to the log (development); smtp: sent through SMTP_HOST
MAIL_BACKEND=console
MAIL_FROM=Osnova <noreply@example.com>
SMTP_HOST=localhost
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_TIMEOUT=10

# --- Background tasks module (emails go through the queue when it is on) ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Docker Compose (optional, compose has the same defaults) ---
# Compose also passes APP_NAME, LANGUAGES and DEFAULT_LANGUAGE to the frontend build
# (link previews and prerendered pages), so set them here, not in the frontend.
# FRONTEND_PORT=8080
# Public site origin for canonical, hreflang, link previews and sitemap.xml
# SITE_URL=https://example.com
# Analytics script URL for the frontend; when set, a cookie banner asks for consent first
# ANALYTICS_SCRIPT=https://analytics.example.com/script.js
# POSTGRES_USER=osnova
# POSTGRES_PASSWORD=osnova
# POSTGRES_DB=osnova
# Run "alembic upgrade head" on every container start (needs DATABASE_URL); with several
# replicas use "make migrate" instead
# RUN_MIGRATIONS=true
