# GENERAL APP SETTINGS
APP_NAME=Osnova Application
APP_VERSION=1.0.0
APP_PROFILE=minimal  # minimal | standard | scalable
APP_HOST=localhost
APP_PORT=8000
DEBUG=True           # для production: False

# CAPABILITIES SETTINGS
AUTH_ENABLED=false
ADMIN_ENABLED=false
FILES_ENABLED=false
NOTIFICATIONS_ENABLED=false
BACKGROUND_TASKS_ENABLED=false

# CORS (для локальной разработки; в Docker один origin — не требуется)
CORS_ORIGINS=http://localhost:5173


# DATABASE (optional in minimal profile — leave empty to run without a database)
DATABASE_URL=

# AUTHENTICATE SETTINGS
SECRET_KEY=secret    # для production: задайте длинный случайный ключ
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=False  # True только при работе по HTTPS

# REDIS SETTINGS
REDIS_URL="redis://localhost:6379/0"

# CELERY SETTINGS
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# OAUTH2 SETTINGS
OAUTH2_CLIENT_ID = "your-client-id"
OAUTH2_CLIENT_SECRET = "your-client-secret"
OAUTH2_REDIRECT_URI = "http://localhost:8000/auth/callback"

# DEPLOYMENT / DOCKER COMPOSE (optional — compose has the same defaults)
# FRONTEND_PORT=8080
# POSTGRES_USER=osnova
# POSTGRES_PASSWORD=osnova
# POSTGRES_DB=osnova
# RUN_MIGRATIONS=true   # выполнить alembic upgrade head при старте (нужен DATABASE_URL)